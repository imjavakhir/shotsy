{
  "sourceLanguage" : "en",
  "strings" : {
    "\"Newer than\" and \"older than\" don't overlap." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Neuer als“ und „älter als“ überschneiden sich nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Más reciente que» y «más antiguo que» no se superponen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Plus récent que » et « plus ancien que » ne se chevauchent pas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Lebih baru dari\" dan \"lebih lama dari\" tidak saling bertumpang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Più recenti di\" e \"più vecchi di\" non si sovrappongono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「より新しい」と「より古い」の範囲が重なっていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘최근’과 ‘이전’ 기간이 겹치지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Mais recente que\" e \"mais antigo que\" não se sobrepõem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Новее чем» и «старше чем» не пересекаются."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mới hơn” và “cũ hơn” không giao nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“晚于”和“早于”没有重叠的日期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「幾天內」與「超過幾天」的範圍沒有重疊。"
          }
        }
      }
    },
