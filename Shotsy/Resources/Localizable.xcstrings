    "Categories and labels are Shotsy's own. They don't change Apple Photos." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategorien und Labels gibt es nur in Shotsy. Sie verändern Apple Fotos nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las categorías y etiquetas son de Shotsy. No modifican Fotos de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les catégories et libellés sont propres à Shotsy. Ils ne modifient pas Apple Photos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategori dan label adalah milik Shotsy. Keduanya tidak mengubah Foto Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Categorie ed etichette sono solo di Shotsy. Non modificano l'app Foto di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カテゴリとラベルはShotsy独自のものです。Appleの写真アプリには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카테고리와 라벨은 Shotsy 전용이에요. Apple 사진 앱에는 영향을 주지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Categorias e etiquetas são do próprio Shotsy. Elas não alteram o app Fotos da Apple."
          }
        },
        "ru" : {
