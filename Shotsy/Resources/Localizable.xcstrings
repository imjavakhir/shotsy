          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces options n’effacent que les données de Shotsy. Elles ne suppriment jamais rien de Photos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
