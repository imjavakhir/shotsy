          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проблема с оплатой. Доступ сохраняется на время льготного периода Apple."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có sự cố thanh toán. Quyền truy cập vẫn tiếp tục trong thời gian gia hạn của Apple."
