    "There's a billing issue. Access continues during Apple's grace period." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt ein Zahlungsproblem. Der Zugriff bleibt während Apples Kulanzfrist bestehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un problema de facturación. El acceso continúa durante el período de gracia de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a un problème de facturation. L’accès continue pendant le délai de grâce d’Apple."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
