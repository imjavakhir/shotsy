    "Photos are analyzed on this iPhone: similar photos, blur, and screenshot text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos werden auf diesem iPhone analysiert: ähnliche Fotos, Unschärfe und Bildschirmfototext."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos se analizan en este iPhone: fotos similares, desenfoque y texto de capturas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos sont analysées sur cet iPhone : photos similaires, flou et texte des captures."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto dianalisis di iPhone ini: foto mirip, buram, dan teks jepretan layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto vengono analizzate su questo iPhone: foto simili, sfocatura e testo delle istantanee."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真はこのiPhone上で分析されます：似ている写真、ブレ、スクリーンショットの文字。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유사한 사진, 흐림, 스크린샷 텍스트는 이 iPhone에서 분석됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos são analisadas neste iPhone: fotos parecidas, desfoque e texto de capturas de tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото анализируются на этом iPhone: похожие снимки, размытие и текст на снимках экрана."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh được phân tích trên iPhone này: ảnh tương tự, độ mờ và chữ trong ảnh màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片在这台 iPhone 上进行分析：相似照片、模糊和截屏文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片會在這支 iPhone 上分析：相似照片、模糊和截圖文字。"
          }
        }
      }
    },
    "Photos couldn't delete these: %@. Nothing was removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos konnte diese nicht löschen: %@. Es wurde nichts entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos no pudo eliminar estos elementos: %@. No se eliminó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos n’a pas pu supprimer ces éléments : %@. Rien n’a été retiré."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto tidak dapat menghapus ini: %@. Tidak ada yang dihapus."
