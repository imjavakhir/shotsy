    "Protected favorites are never suggested for deletion and start unselected in the review." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschützte Favoriten werden nie zum Löschen vorgeschlagen und sind bei der Prüfung anfangs nicht ausgewählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los favoritos protegidos nunca se sugieren para eliminar y empiezan sin seleccionar en la revisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les favoris protégés ne sont jamais proposés à la suppression et sont désélectionnés par défaut lors de la vérification."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorit yang dilindungi tidak pernah disarankan untuk dihapus dan awalnya tidak dipilih saat ditinjau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I preferiti protetti non vengono mai suggeriti per l'eliminazione e partono deselezionati nella revisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保護されたお気に入りが削除候補になることはなく、レビューでも最初は選択されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보호된 즐겨찾기는 삭제 제안에 포함되지 않으며, 검토 시 선택 해제된 상태로 시작해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoritos protegidos nunca são sugeridos para apagar e começam desmarcados na revisão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защищенные избранные фото никогда не предлагаются к удалению и при проверке изначально не выбраны."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục ưa thích được bảo vệ sẽ không bao giờ được gợi ý xóa và mặc định không được chọn khi xem lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受保护的个人收藏绝不会被建议删除，并在确认删除时默认不选中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受保護的喜好項目絕不會被建議刪除，在檢視時也預設不選取。"
          }
        }
      }
    },
