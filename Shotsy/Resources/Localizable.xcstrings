    "The compressed copy didn't pass checks, so it was discarded. The original is unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die komprimierte Kopie hat die Prüfung nicht bestanden und wurde verworfen. Das Original ist unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia comprimida no pasó las comprobaciones, así que se descartó. El original no cambió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie compressée n’a pas passé les vérifications, elle a donc été supprimée. L’original n’a pas changé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan terkompresi tidak lolos pemeriksaan, jadi dibuang. File asli tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia compressa non ha superato i controlli ed è stata scartata. L'originale non è stato modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圧縮したコピーがチェックを通過しなかったため、破棄しました。オリジナルは変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압축 사본이 확인을 통과하지 못해 버렸어요. 원본은 그대로입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia comprimida não passou nas verificações e foi descartada. O original não foi alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сжатая копия не прошла проверку и была удалена. Оригинал не изменен."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản nén không vượt qua kiểm tra nên đã bị loại bỏ. Bản gốc không thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "压缩副本未通过检查，已被丢弃。原件未更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壓縮副本未通過檢查，因此已捨棄。原始檔沒有變動。"
          }
        }
      }
    },
    "The copy is %@ smaller. Space is only freed if you delete the original and Recently Deleted is emptied." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie ist %@ kleiner. Speicher wird erst frei, wenn du das Original löschst und „Zuletzt gelöscht“ geleert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia ocupa %@ menos. El espacio solo se libera si eliminas el original y se vacía Eliminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie est plus petite de %@. L’espace n’est libéré que si vous supprimez l’original et videz Suppressions récentes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinannya %@ lebih kecil. Ruang hanya kosong jika Anda menghapus file asli dan Baru Dihapus dikosongkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia è più piccola di %@. Lo spazio si libera solo se elimini l'originale e svuoti Eliminati di recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーは%@小さくなりました。容量が空くのは、オリジナルを削除して「最近削除した項目」を空にした場合のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사본이 %@ 더 작아요. 원본을 삭제하고 ‘최근 삭제된 항목’을 비워야 공간이 확보됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia é %@ menor. O espaço só é liberado se você apagar o original e esvaziar Apagados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия меньше на %@. Место освободится, только если удалить оригинал и очистить «Недавно удаленные»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao nhỏ hơn %@. Dung lượng chỉ được giải phóng khi bạn xóa bản gốc và dọn sạch Đã xóa gần đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "副本缩小了 %@。只有删除原件并清空“最近删除”后才会释放空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "副本縮小了 %@。只有在你刪除原始檔並清空「最近刪除」後，才會釋放空間。"
          }
        }
      }
    },
    "The copy isn't smaller than the original, so it won't be saved. Try a smaller option." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie ist nicht kleiner als das Original und wird daher nicht gesichert. Probier eine kleinere Option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia no es más pequeña que el original, así que no se guardará. Prueba una opción más pequeña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie n’est pas plus petite que l’original, elle ne sera donc pas enregistrée. Essayez une option plus compacte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinannya tidak lebih kecil dari aslinya, jadi tidak akan disimpan. Coba opsi yang lebih kecil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia non è più piccola dell'originale, quindi non verrà salvata. Prova un'opzione più leggera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーがオリジナルより小さくならないため、保存されません。より小さいオプションを試してください。"
          }
        },
