    "Favorite and not favorite can't both match." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Favorit“ und „kein Favorit“ können nicht beide zutreffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puede ser favorito y no favorito a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favori et non favori ne peuvent pas correspondre en même temps."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorit dan bukan favorit tidak bisa cocok bersamaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Preferito\" e \"non preferito\" non possono valere insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「お気に入り」と「お気に入りではない」の両方に一致することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾기와 즐겨찾기 아님은 동시에 일치할 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorita e não favorita não podem valer ao mesmo tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объект не может быть одновременно в Избранном и не в Избранном."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể khớp cả ưa thích lẫn không ưa thích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“是个人收藏”和“不是个人收藏”不能同时满足。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「是喜好項目」與「不是喜好項目」不能同時符合。"
          }
        }
      }
    },
