    "Slow motion is saved as it plays now and can't be adjusted later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeitlupe wird so gesichert, wie sie jetzt abgespielt wird, und lässt sich später nicht mehr anpassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara lenta se guarda tal como se reproduce ahora y no se podrá ajustar después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ralenti est enregistré tel qu’il est lu maintenant et ne pourra plus être ajusté."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerak lambat disimpan seperti yang diputar sekarang dan tidak bisa diubah nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo slow motion viene salvato così come viene riprodotto ora e non potrà essere regolato in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スローモーションは現在の再生どおりに保存され、あとから調整できなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "슬로 모션은 현재 재생되는 그대로 저장되며 나중에 조정할 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera lenta é salva como é reproduzida agora e não poderá ser ajustada depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замедленное видео сохранится так, как воспроизводится сейчас, и потом его нельзя будет настроить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video quay chậm được lưu như đang phát và không thể chỉnh lại sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢动作会按当前播放效果存储，之后无法调整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢動作會依目前的播放效果儲存，之後無法再調整。"
          }
        }
      }
    },
