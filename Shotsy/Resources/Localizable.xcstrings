    "Shotsy can see only the photos you selected. Counts cover those photos." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy sieht nur die Fotos, die du ausgewählt hast. Die Zahlen beziehen sich auf diese Fotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy solo puede ver las fotos que seleccionaste. Los conteos incluyen solo esas fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy ne voit que les photos que vous avez sélectionnées. Les chiffres portent sur ces photos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy hanya bisa melihat foto yang Anda pilih. Jumlahnya hanya mencakup foto tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy vede solo le foto che hai selezionato. I conteggi si riferiscono a quelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsyは選択された写真のみを表示できます。件数はそれらの写真が対象です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy는 선택한 사진만 볼 수 있어요. 개수는 해당 사진 기준입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shotsy só vê as fotos que você selecionou. As contagens se referem a essas fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy видит только выбранные вами фото. Подсчеты касаются только их."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy chỉ thấy được những ảnh bạn đã chọn. Số liệu chỉ tính các ảnh đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy 只能看到你选择的照片，统计数量仅涵盖这些照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy 只能看到你選取的照片，數量也只計算這些照片。"
          }
        }
      }
    },
    "Shotsy checks new and edited photos when your library changes. Turn off automatic scanning to scan only when you tap Scan Now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy prüft neue und bearbeitete Fotos, wenn sich deine Mediathek ändert. Schalte automatisches Scannen aus, um nur über „Jetzt scannen“ zu scannen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy revisa las fotos nuevas y editadas cuando cambia tu fototeca. Desactiva el análisis automático para analizar solo al tocar Analizar ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy vérifie les photos nouvelles et modifiées quand votre photothèque change. Désactivez l'analyse automatique pour analyser seulement en touchant Analyser maintenant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy memeriksa foto baru dan yang diedit saat perpustakaanmu berubah. Matikan pemindaian otomatis untuk memindai hanya saat kamu mengetuk Pindai Sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy controlla le foto nuove e modificate quando la libreria cambia. Disattiva la scansione automatica per scansionare solo toccando Scansiona ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリが変わると、Shotsyは新しい写真と編集された写真を確認します。自動スキャンをオフにすると、「今すぐスキャン」をタップしたときだけスキャンします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함이 바뀌면 Shotsy가 새 사진과 편집된 사진을 확인합니다. 자동 스캔을 끄면 지금 스캔을 탭할 때만 스캔합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shotsy verifica fotos novas e editadas quando sua fototeca muda. Desative a análise automática para analisar só ao tocar em Analisar agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy проверяет новые и изменённые фото, когда меняется медиатека. Выключите автоматическое сканирование, чтобы сканировать только по кнопке «Сканировать сейчас»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy kiểm tra ảnh mới và ảnh đã sửa khi thư viện thay đổi. Tắt tự động quét để chỉ quét khi bạn chạm Quét ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图库发生变化时，Shotsy 会检查新增和编辑过的照片。关闭自动扫描后，只有轻点“立即扫描”时才会扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖庫變更時，Shotsy 會檢查新增和編輯過的照片。關閉自動掃描後，只有點一下「立即掃描」時才會掃描。"
          }
        }
      }
    },
    "Shotsy doesn't send your photos, text, or identifiers to any server. There are no analytics SDKs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy sendet deine Fotos, Texte oder Kennungen an keinen Server. Es gibt keine Analyse-SDKs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy no envía tus fotos, textos ni identificadores a ningún servidor. No hay SDK de analítica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy n’envoie vos photos, textes ou identifiants à aucun serveur. Aucun SDK d’analyse n’est utilisé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy tidak mengirim foto, teks, atau pengenal Anda ke server mana pun. Tidak ada SDK analitik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy non invia a nessun server le tue foto, testi o identificatori. Non ci sono SDK di analisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsyは写真、文字、識別子をサーバに送信しません。分析用SDKも使用していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy는 사진, 텍스트, 식별자를 어떤 서버로도 보내지 않아요. 분석용 SDK도 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shotsy não envia suas fotos, textos ou identificadores para nenhum servidor. Não há SDKs de análise de uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy не отправляет ваши фото, текст или идентификаторы ни на какие серверы. SDK аналитики нет."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy không gửi ảnh, chữ hay mã định danh của bạn đến bất kỳ máy chủ nào. Không có SDK phân tích nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy 不会将你的照片、文字或标识符发送到任何服务器，也不包含任何分析 SDK。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy 不會將你的照片、文字或識別碼傳送到任何伺服器，也沒有使用任何分析 SDK。"
          }
        }
      }
    },
    "Shotsy needs photo access to sort, group, and search. Everything is analyzed on this iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy braucht Fotozugriff zum Sortieren, Gruppieren und Suchen. Alles wird auf diesem iPhone analysiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy necesita acceso a las fotos para ordenar, agrupar y buscar. Todo se analiza en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy a besoin d’accéder à vos photos pour trier, regrouper et rechercher. Tout est analysé sur cet iPhone."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy memerlukan akses foto untuk memilah, mengelompokkan, dan mencari. Semuanya dianalisis di iPhone ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy ha bisogno dell'accesso alle foto per ordinare, raggruppare e cercare. Tutto viene analizzato su questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整理、グループ分け、検索のために、Shotsyには写真へのアクセスが必要です。分析はすべてこのiPhone上で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy가 정리, 그룹화, 검색을 하려면 사진 접근 권한이 필요해요. 모든 분석은 이 iPhone에서 이루어집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shotsy precisa de acesso às fotos para organizar, agrupar e buscar. Tudo é analisado neste iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy нужен доступ к фото, чтобы сортировать, группировать и искать. Все анализируется на этом iPhone."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy cần quyền truy cập ảnh để phân loại, nhóm và tìm kiếm. Mọi thứ đều được phân tích trên iPhone này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy 需要照片访问权限才能整理、分组和搜索。所有分析都在这台 iPhone 上进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy 需要照片取用權限才能整理、分組和搜尋。所有分析都在這支 iPhone 上進行。"
          }
        }
      }
    },
    "Shotsy saves compressed video copies to your library when you ask it to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy sichert komprimierte Videokopien in deiner Mediathek, wenn du darum bittest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy guarda copias comprimidas de videos en tu fototeca cuando se lo pides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy enregistre des copies de vidéos compressées dans votre photothèque quand vous le demandez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy menyimpan salinan video terkompresi ke perpustakaan Anda saat Anda memintanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy salva copie compresse dei video nella libreria quando glielo chiedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsyは、あなたが指示したときにだけ圧縮したビデオのコピーをライブラリに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy는 요청할 때만 압축된 비디오 사본을 보관함에 저장해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shotsy salva cópias comprimidas de vídeos na sua biblioteca quando você pede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy сохраняет сжатые копии видео в медиатеку, только когда вы попросите."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy lưu bản sao video đã nén vào thư viện khi bạn yêu cầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你要求时，Shotsy 会将压缩后的视频副本存储到你的图库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你要求時，Shotsy 才會將壓縮後的影片副本儲存到圖庫。"
          }
        }
      }
    },
    "Shotsy sorts, groups, and searches your photos on this iPhone. It changes your library only when you choose an action." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy sortiert, gruppiert und durchsucht deine Fotos auf diesem iPhone. Deine Mediathek ändert sich nur, wenn du eine Aktion wählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy ordena, agrupa y busca tus fotos en este iPhone. Solo cambia tu fototeca cuando eliges una acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy trie, regroupe et recherche vos photos sur cet iPhone. Votre photothèque ne change que lorsque vous choisissez une action."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy memilah, mengelompokkan, dan mencari foto Anda di iPhone ini. Perpustakaan Anda hanya berubah saat Anda memilih tindakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy ordina, raggruppa e cerca le tue foto su questo iPhone. Modifica la libreria solo quando scegli un'azione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShotsyはこのiPhone上で写真を整理、グループ分け、検索します。ライブラリが変更されるのは、あなたが操作を選んだときだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy는 이 iPhone에서 사진을 정리, 그룹화, 검색해요. 동작을 선택할 때만 보관함이 변경됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shotsy organiza, agrupa e busca suas fotos neste iPhone. Ele só altera sua biblioteca quando você escolhe uma ação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy сортирует, группирует и ищет ваши фото на этом iPhone. Медиатека меняется, только когда вы выбираете действие."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy phân loại, nhóm và tìm kiếm ảnh ngay trên iPhone này. Thư viện chỉ thay đổi khi bạn chọn một tác vụ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy 在这台 iPhone 上整理、分组和搜索你的照片。只有在你选择操作时才会更改你的图库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotsy 在這支 iPhone 上整理、分組和搜尋你的照片。只有在你選擇動作時才會更動圖庫。"
          }
        }
      }
    },
    "Shotsy's saved filters. They update on their own and aren't Photos albums." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesicherte Filter in Shotsy. Sie aktualisieren sich selbst und sind keine Fotos-Alben."
