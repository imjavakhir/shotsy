    "Label and pin screenshots for free. Automatic categories and text search come with Shotsy Pro." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmfotos kostenlos labeln und anheften. Automatische Kategorien und Textsuche gibt es mit Shotsy Pro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiqueta y fija capturas gratis. Las categorías automáticas y la búsqueda de texto vienen con Shotsy Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étiquetez et épinglez vos captures gratuitement. Les catégories automatiques et la recherche de texte sont incluses dans Shotsy Pro."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri label dan sematkan jepretan layar secara gratis. Kategori otomatis dan pencarian teks tersedia di Shotsy Pro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etichetta e fissa le istantanee schermo gratis. Categorie automatiche e ricerca testo sono incluse in Shotsy Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットのラベル付けとピン留めは無料。自動カテゴリと文字検索はShotsy Proで使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷 라벨 지정과 고정은 무료예요. 자동 카테고리와 텍스트 검색은 Shotsy Pro에 포함됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquete e fixe capturas de tela de graça. Categorias automáticas e busca de texto vêm com o Shotsy Pro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечайте и закрепляйте снимки экрана бесплатно. Автокатегории и поиск по тексту — в Shotsy Pro."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gắn nhãn và ghim ảnh màn hình miễn phí. Danh mục tự động và tìm kiếm chữ có trong Shotsy Pro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费为截屏添加标签和置顶。自动分类和文字搜索需要 Shotsy Pro。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費為截圖加標籤和釘選。自動分類和文字搜尋隨附於 Shotsy Pro。"
          }
        }
      }
    },
