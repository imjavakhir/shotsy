        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto non è riuscita a eliminare questi elementi: %@. Non è stato rimosso niente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真アプリでこれらを削除できませんでした：%@。何も削除されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 앱에서 다음 항목을 삭제하지 못했어요: %@. 아무것도 제거되지 않았어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fotos não conseguiu apagar estes itens: %@. Nada foi removido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото не удалось удалить: %@. Ничего не удалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh không thể xóa các mục sau: %@. Chưa có gì bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“照片”无法删除以下项目：%@。未移除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「照片」無法刪除這些項目：%@。沒有移除任何項目。"
          }
        }
      }
    },
    "Photos doesn't allow editing this album. You can still view, share, or mark items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos erlaubt keine Bearbeitung dieses Albums. Du kannst Objekte aber ansehen, teilen oder markieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos no permite editar este álbum. Aun así puedes ver, compartir o marcar elementos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos ne permet pas de modifier cet album. Vous pouvez toujours afficher, partager ou marquer des éléments."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto tidak mengizinkan album ini diedit. Anda tetap bisa melihat, membagikan, atau menandai item."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto non consente di modificare questo album. Puoi comunque vedere, condividere o segnare gli elementi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真アプリではこのアルバムを編集できません。項目の表示、共有、マークは可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 앱에서 이 앨범의 편집을 허용하지 않아요. 항목 보기, 공유, 표시는 계속 할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fotos não permite editar este álbum. Você ainda pode ver, compartilhar ou marcar itens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото не разрешает изменять этот альбом. Но вы можете просматривать, отправлять и отмечать объекты."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh không cho phép chỉnh sửa album này. Bạn vẫn có thể xem, chia sẻ hoặc đánh dấu mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“照片”不允许编辑此相簿。你仍然可以查看、共享或标记项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「照片」不允許編輯這個相簿。你仍然可以檢視、分享或標記項目。"
          }
        }
      }
    },
    "Photos doesn't allow this change for this album." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos erlaubt diese Änderung für dieses Album nicht."
          }
        },
        "es" : {
          "stringUnit" : {
