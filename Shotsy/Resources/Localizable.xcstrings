    "Hi, I'm Shotsy. I help you sort your camera roll a little at a time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi, ich bin Shotsy. Ich helfe dir, deine Fotos Stück für Stück zu sortieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola, soy Shotsy. Te ayudo a ordenar tu carrete poco a poco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour, je suis Shotsy. Je vous aide à trier votre pellicule, un peu à la fois."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai, saya Shotsy. Saya bantu Anda memilah rol kamera sedikit demi sedikit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao, sono Shotsy. Ti aiuto a riordinare il rullino un po' alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは、Shotsyです。カメラロールの整理を少しずつお手伝いします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요, 저는 Shotsy예요. 카메라 롤을 조금씩 정리하도록 도와드릴게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi, eu sou o Shotsy. Ajudo você a organizar suas fotos aos pouquinhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет, я Shotsy. Помогаю разбирать фотопленку понемногу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chào bạn, mình là Shotsy. Mình giúp bạn phân loại thư viện ảnh từng chút một."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好，我是 Shotsy。我会帮你一点一点整理相机胶卷。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嗨，我是 Shotsy。我會陪你一點一點整理相機膠卷。"
          }
        }
      }
    },
