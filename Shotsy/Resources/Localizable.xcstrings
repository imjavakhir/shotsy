    "I found %lld groups of similar photos and %lld that might be blurry. Take a look when you like." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe %lld Gruppen ähnlicher Fotos und %lld möglicherweise unscharfe gefunden. Schau rein, wann du magst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontré %lld grupos de fotos similares y %lld fotos que podrían estar borrosas. Échales un vistazo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai trouvé %lld groupes de photos similaires et %lld photos peut-être floues. Jetez-y un œil quand vous voulez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya menemukan %lld grup foto mirip dan %lld yang mungkin buram. Lihat saja kapan pun Anda mau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho trovato %lld gruppi di foto simili e %lld foto forse sfocate. Dai un'occhiata quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似ている写真のグループを%lld件と、ブレているかもしれない写真を%lld枚見つけました。お好きなときに見てみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유사한 사진 그룹 %lld개와 흐릴 수 있는 사진 %lld장을 찾았어요. 편할 때 살펴보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontrei %lld grupos de fotos parecidas e %lld que podem estar desfocadas. Dê uma olhada quando quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я нашел похожие фото (групп: %lld) и возможно размытые (фото: %lld). Посмотрите, когда будет удобно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mình tìm thấy %lld nhóm ảnh tương tự và %lld ảnh có thể bị mờ. Xem khi nào bạn rảnh nhé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我找到了 %lld 组相似照片，还有 %lld 张可能有点模糊。有空时看看吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我找到 %lld 組相似照片，還有 %lld 張可能模糊的照片。有空再來看看吧。"
          }
        }
      }
    },
