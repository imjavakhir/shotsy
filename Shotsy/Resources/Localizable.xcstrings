    "Compression is lossy: the copy won't be identical to the original. Orientation, audio, date and location are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Komprimierung ist verlustbehaftet: Die Kopie ist nicht identisch mit dem Original. Ausrichtung, Audio, Datum und Ort bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compresión pierde calidad: la copia no será idéntica al original. Se conservan la orientación, el audio, la fecha y la ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compression entraîne une perte : la copie ne sera pas identique à l’original. L’orientation, l’audio, la date et le lieu sont conservés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompresi mengurangi kualitas: salinannya tidak akan identik dengan aslinya. Orientasi, audio, tanggal, dan lokasi tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compressione comporta una perdita di qualità: la copia non sarà identica all'originale. Orientamento, audio, data e posizione vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圧縮は非可逆のため、コピーはオリジナルと完全には同じになりません。向き、オーディオ、日付、位置情報は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손실 압축이라 사본이 원본과 완전히 같지는 않아요. 방향, 오디오, 날짜, 위치는 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A compressão tem perdas: a cópia não será idêntica ao original. Orientação, áudio, data e localização são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сжатие идет с потерями: копия не будет идентична оригиналу. Ориентация, звук, дата и геопозиция сохраняются."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nén có làm giảm chất lượng: bản sao sẽ không giống hệt bản gốc. Hướng xoay, âm thanh, ngày và vị trí được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "压缩是有损的：副本与原件不会完全相同。方向、音频、日期和位置会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壓縮屬於破壞性壓縮：副本不會與原始檔完全相同。方向、音訊、日期和位置都會保留。"
          }
        }
      }
    },
