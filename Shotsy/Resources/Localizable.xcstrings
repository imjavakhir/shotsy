    "Each burst keeps your pick, or the shot Photos picked. Tap a photo to keep it instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von jeder Serie bleibt deine Auswahl oder das von Fotos gewählte Bild. Tippe auf ein anderes Foto, um es zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De cada ráfaga se conserva tu selección o la foto que eligió Fotos. Toca otra foto para conservarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque rafale garde votre choix ou la photo choisie par Photos. Touchez une autre photo pour la garder."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap burst menyimpan pilihan Anda, atau foto yang dipilih Foto. Ketuk foto lain untuk menyimpannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di ogni raffica resta la tua scelta o lo scatto scelto da Foto. Tocca un'altra foto per tenerla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各バーストでは、あなたが選んだ写真、または写真アプリが選んだ写真を残します。別の写真をタップするとそちらを残します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 연사에서 직접 고른 사진이나 사진 앱이 고른 사진을 남깁니다. 다른 사진을 탭하면 그 사진을 남깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada sequência mantém sua escolha ou a foto escolhida pelo app Fotos. Toque em outra foto para mantê-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В каждой серии остаётся ваш выбор или снимок, выбранный Фото. Коснитесь другого фото, чтобы оставить его."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi loạt ảnh giữ lại ảnh bạn chọn, hoặc ảnh do Ảnh chọn. Chạm vào ảnh khác để giữ ảnh đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每组连拍会保留你选的照片，或“照片”自动选的那张。轻点其他照片即可改为保留它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每組連拍會保留你選的照片，或「照片」自動選的那張。點一下其他照片即可改為保留它。"
          }
        }
      }
    },
