    "Spatial video can't be compressed without losing its 3D depth." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räumliches Video kann nicht komprimiert werden, ohne seine 3D-Tiefe zu verlieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El video espacial no se puede comprimir sin perder su profundidad 3D."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une vidéo spatiale ne peut pas être compressée sans perdre sa profondeur 3D."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video spasial tidak bisa dikompres tanpa kehilangan kedalaman 3D-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un video spaziale non può essere compresso senza perdere la profondità 3D."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空間ビデオは、3Dの奥行きを失わずに圧縮することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공간 비디오는 3D 깊이감을 잃지 않고는 압축할 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vídeo espacial não pode ser comprimido sem perder a profundidade 3D."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пространственное видео нельзя сжать без потери 3D-глубины."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể nén video không gian mà không mất chiều sâu 3D."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空间视频无法压缩，否则会失去 3D 深度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空間影片壓縮後會失去 3D 景深。"
          }
        }
      }
    },
