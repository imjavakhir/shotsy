          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos ne permet pas cette modification pour cet album."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto tidak mengizinkan perubahan ini untuk album ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
