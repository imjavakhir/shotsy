    "This makes a regular Photos album with today's matches. Unlike the Smart Collection, it won't update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit entsteht ein normales Fotos-Album mit den heutigen Treffern. Anders als die intelligente Sammlung wird es nicht aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto crea un álbum normal de Fotos con las coincidencias de hoy. A diferencia de la colección inteligente, no se actualizará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela crée un album Photos classique avec les résultats d’aujourd’hui. Contrairement à la collection intelligente, il ne se mettra pas à jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini membuat album Foto biasa berisi hasil hari ini. Berbeda dengan Koleksi Pintar, album ini tidak akan diperbarui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un normale album in Foto con i risultati di oggi. A differenza della raccolta smart, non si aggiornerà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日時点で一致する項目で通常の写真アルバムを作成します。スマートコレクションとは違い、更新されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 기준 일치 항목으로 일반 사진 앱 앨범을 만들어요. 스마트 컬렉션과 달리 업데이트되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso cria um álbum comum no Fotos com os resultados de hoje. Diferente da Coleção Inteligente, ele não será atualizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет создан обычный альбом в Фото с сегодняшними совпадениями. В отличие от смарт-коллекции, он не будет обновляться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này tạo một album Ảnh thông thường với các kết quả khớp hôm nay. Khác với Bộ sưu tập thông minh, album này sẽ không cập nhật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会用今天的匹配结果创建一个普通的“照片”相簿。与智能集合不同，它不会更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會以今天的符合項目建立一般的「照片」相簿。與智慧收藏集不同，它不會更新。"
          }
        }
      }
