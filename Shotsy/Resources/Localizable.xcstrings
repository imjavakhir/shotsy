    "Adds a new JPG to your library with the same date, location and camera details. The original stays as it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt deiner Mediathek ein neues JPG mit gleichem Datum, Ort und Kameradaten hinzu. Das Original bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un JPG nuevo a tu fototeca con la misma fecha, ubicación y datos de cámara. El original no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un nouveau JPG à votre photothèque avec la même date, le même lieu et les mêmes infos d'appareil. L'original reste tel quel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan JPG baru ke pustaka dengan tanggal, lokasi, dan detail kamera yang sama. File asli tetap seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge un nuovo JPG alla libreria con la stessa data, posizione e dati della fotocamera. L'originale resta invariato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ日付、位置情報、カメラ情報で新しいJPGをライブラリに追加します。オリジナルはそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 날짜, 위치, 카메라 정보로 새 JPG를 보관함에 추가합니다. 원본은 그대로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um novo JPG à sua fototeca com a mesma data, localização e dados da câmera. O original continua igual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет в медиатеку новый JPG с той же датой, местом и данными камеры. Оригинал не меняется."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm một ảnh JPG mới vào thư viện với cùng ngày, vị trí và thông tin máy ảnh. Bản gốc giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以相同的日期、位置和相机信息向图库添加新的 JPG。原件保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以相同的日期、位置和相機資訊在圖庫中加入新的 JPG。原始檔保持不變。"
          }
        }
      }
    },
