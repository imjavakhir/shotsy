    "Clear similar photos, duplicates, and blurry shots at once. Shrink big videos too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ähnliche Fotos, Duplikate und unscharfe Aufnahmen auf einmal aufräumen. Und große Videos verkleinern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina fotos similares, duplicadas y borrosas de una vez. Y reduce los videos grandes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éliminez photos similaires, doublons et photos floues d’un coup. Réduisez aussi les grosses vidéos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersihkan foto mirip, duplikat, dan foto buram sekaligus. Perkecil juga video besar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina in un colpo foto simili, doppioni e scatti sfocati. E riduci i video pesanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似ている写真、重複、ブレた写真をまとめて整理。大きなビデオも小さくできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유사한 사진, 중복, 흐린 사진을 한 번에 정리하고, 큰 비디오도 줄여 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimine fotos parecidas, duplicadas e desfocadas de uma vez. E reduza vídeos grandes também."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убирайте похожие фото, дубликаты и размытые снимки разом. И сжимайте большие видео."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dọn ảnh tương tự, ảnh trùng lặp và ảnh mờ cùng lúc. Thu nhỏ cả video lớn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次清理相似照片、重复项和模糊照片，还能压缩大视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次清掉相似照片、重複項目和模糊照片，還能縮小大型影片。"
          }
        }
      }
    },
