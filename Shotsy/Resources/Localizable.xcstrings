    "Scanning is waiting for Low Power Mode to end. Tap Scan Now to scan anyway." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Scan wartet, bis der Stromsparmodus endet. Tippe auf „Jetzt scannen“, um trotzdem zu scannen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El análisis espera a que termine el modo de bajo consumo. Toca Analizar ahora para hacerlo de todos modos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'analyse attend la fin du mode Économie d'énergie. Touchez Analyser maintenant pour lancer quand même."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemindaian menunggu Mode Daya Rendah berakhir. Ketuk Pindai Sekarang untuk tetap memindai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scansione attende la fine della modalità Risparmio energetico. Tocca Scansiona ora per procedere comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低電力モードが終わるまでスキャンを待機しています。すぐに行う場合は「今すぐスキャン」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저전력 모드가 끝날 때까지 스캔을 기다리고 있습니다. 바로 스캔하려면 지금 스캔을 탭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A análise está aguardando o fim do Modo Pouca Energia. Toque em Analisar agora para analisar mesmo assim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканирование ждёт окончания режима энергосбережения. Нажмите «Сканировать сейчас», чтобы начать всё равно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc quét đang chờ Chế độ nguồn điện thấp kết thúc. Chạm Quét ngay để quét luôn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描正在等待低电量模式结束。轻点“立即扫描”可直接扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描正在等待低耗電模式結束。點一下「立即掃描」可直接掃描。"
          }
        }
      }
    },
