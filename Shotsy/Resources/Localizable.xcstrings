    "An item can't be two media types at once. Use Any, or keep one type." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Objekt kann nicht zwei Medientypen gleichzeitig haben. Wähle „Beliebig“ oder nur einen Typ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elemento no puede ser de dos tipos a la vez. Usa Cualquiera o deja un solo tipo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un élément ne peut pas avoir deux types à la fois. Choisissez Tous, ou gardez un seul type."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item tidak bisa memiliki dua jenis media sekaligus. Gunakan Apa Saja, atau pilih satu jenis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elemento non può avere due tipi di media. Usa Qualsiasi o tieni un solo tipo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つの項目が2種類のメディアタイプを持つことはできません。「すべて」を選ぶか、タイプを1つにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 항목이 두 가지 미디어 유형일 수는 없어요. ‘모두’를 사용하거나 한 유형만 남기세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um item não pode ter dois tipos de mídia ao mesmo tempo. Use Qualquer um ou mantenha só um tipo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объект не может быть двух типов сразу. Выберите «Любой» или оставьте один тип."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một mục không thể có hai loại phương tiện cùng lúc. Hãy chọn Bất kỳ hoặc giữ một loại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
