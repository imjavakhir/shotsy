    "Read text in %lld of %lld screenshots. Suggestions are English-keyword based; other languages show as Other." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text in %lld von %lld Bildschirmfotos gelesen. Vorschläge basieren auf englischen Stichwörtern; andere Sprachen erscheinen als „Sonstiges“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto leído en %lld de %lld capturas. Las sugerencias se basan en palabras clave en inglés; otros idiomas aparecen como Otros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte lu dans %lld captures sur %lld. Les suggestions reposent sur des mots-clés anglais ; les autres langues sont classées dans Autre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks terbaca di %lld dari %lld jepretan layar. Saran berdasarkan kata kunci bahasa Inggris; bahasa lain ditampilkan sebagai Lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testo letto in %lld di %lld istantanee schermo. I suggerimenti si basano su parole chiave inglesi; le altre lingue appaiono come Altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld枚中%1$lld枚のスクリーンショットの文字を読み取りました。候補は英語のキーワードに基づくため、ほかの言語は「その他」になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷 %lld/%lld장의 텍스트를 읽었어요. 제안은 영어 키워드 기반이며, 다른 언어는 ‘기타’로 표시돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto lido em %lld de %lld capturas de tela. As sugestões usam palavras-chave em inglês; outros idiomas aparecem como Outros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст распознан на %lld из %lld снимков экрана. Предложения основаны на английских ключевых словах; другие языки попадают в «Другое»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã đọc chữ trong %lld/%lld ảnh màn hình. Gợi ý dựa trên từ khóa tiếng Anh; ngôn ngữ khác hiển thị là Khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已读取 %lld/%lld 张截屏的文字。建议基于英文关键词，其他语言会归入“其他”。"
          }
        },
        "zh-Hant" : {
