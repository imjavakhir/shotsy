    "Tap to deselect anything you want to keep. Deselected items stay in the queue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe, um alles abzuwählen, was du behalten willst. Abgewählte Objekte bleiben in der Warteschlange."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para quitar la selección de lo que quieras conservar. Los elementos no seleccionados se quedan en la cola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour désélectionner ce que vous voulez garder. Les éléments désélectionnés restent dans la file."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk untuk membatalkan pilihan yang ingin Anda simpan. Item yang batal dipilih tetap di antrean."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per deselezionare ciò che vuoi tenere. Gli elementi deselezionati restano in coda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残したいものはタップして選択を解除してください。選択を解除した項目はキューに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "남기고 싶은 항목은 탭해서 선택 해제하세요. 선택 해제한 항목은 대기열에 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para desmarcar o que quiser manter. Itens desmarcados continuam na fila."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь, чтобы снять выбор с того, что хотите оставить. Невыбранные объекты остаются в очереди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm để bỏ chọn những gì bạn muốn giữ. Mục bỏ chọn vẫn ở trong hàng chờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点以取消选择想保留的项目。取消选择的项目仍留在队列中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下即可取消選取想保留的項目。取消選取的項目會留在佇列中。"
          }
        }
      }
    },
