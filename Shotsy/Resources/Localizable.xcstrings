    },
    "These only clear Shotsy's own data. They never delete anything from Photos." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden nur die Daten von Shotsy gelöscht. Aus Fotos wird nie etwas gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
