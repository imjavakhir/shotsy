    "A gentle local notification: “Ready for a quick photo sort?” Delivery depends on your notification settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine sanfte lokale Mitteilung: „Lust auf eine kurze Fotorunde?“ Die Zustellung hängt von deinen Mitteilungseinstellungen ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notificación local discreta: “¿Ordenamos unas fotos rápido?” Su entrega depende de tu configuración de notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une notification locale discrète : « Prêt pour un petit tri photo ? » La réception dépend de vos réglages de notifications."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi lokal yang ramah: “Siap memilah foto sebentar?” Pengirimannya bergantung pada pengaturan notifikasi Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notifica locale discreta: “Pronto a ordinare qualche foto?” La consegna dipende dalle impostazioni delle notifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ちょっと写真を整理しませんか？」というやさしい通知が届きます。通知の設定によっては届かない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가벼운 로컬 알림: “사진 잠깐 정리해 볼까요?” 알림 설정에 따라 전달됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma notificação local discreta: “Que tal organizar umas fotos rapidinho?” A entrega depende dos seus ajustes de notificação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мягкое локальное уведомление: “Разберем фото по-быстрому?” Доставка зависит от настроек уведомлений."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thông báo nhẹ nhàng trên máy: “Sẵn sàng phân loại ảnh nhanh chưa?” Việc hiển thị tùy thuộc vào cài đặt thông báo của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一条轻柔的本地通知：“来快速整理一下照片吗？”是否送达取决于你的通知设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一則溫和的本機通知：「要不要快速整理一下照片？」是否送達取決於你的通知設定。"
          }
        }
      }
    },
