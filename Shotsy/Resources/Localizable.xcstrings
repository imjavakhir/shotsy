    "All analysis runs on this iPhone. Screenshot text search and suggestions are part of Shotsy Pro. Supported text languages: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gesamte Analyse läuft auf diesem iPhone. Textsuche in Bildschirmfotos und Vorschläge gehören zu Shotsy Pro. Unterstützte Textsprachen: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el análisis se hace en este iPhone. La búsqueda de texto en capturas de pantalla y las sugerencias son parte de Shotsy Pro. Idiomas de texto compatibles: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute l’analyse se fait sur cet iPhone. La recherche de texte dans les captures et les suggestions font partie de Shotsy Pro. Langues prises en charge : %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua analisis berjalan di iPhone ini. Pencarian teks jepretan layar dan saran termasuk dalam Shotsy Pro. Bahasa teks yang didukung: %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le analisi avvengono su questo iPhone. La ricerca del testo nelle istantanee schermo e i suggerimenti fanno parte di Shotsy Pro. Lingue supportate: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析はすべてこのiPhone上で行われます。スクリーンショットの文字検索と候補はShotsy Proの機能です。対応言語：%@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 분석은 이 iPhone에서 이루어집니다. 스크린샷 텍스트 검색과 제안은 Shotsy Pro 기능입니다. 지원 언어: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda a análise acontece neste iPhone. A busca de texto em capturas de tela e as sugestões fazem parte do Shotsy Pro. Idiomas de texto compatíveis: %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Весь анализ выполняется на этом iPhone. Поиск текста на снимках экрана и предложения входят в Shotsy Pro. Поддерживаемые языки текста: %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi phân tích đều chạy trên iPhone này. Tìm kiếm chữ trong ảnh màn hình và gợi ý thuộc Shotsy Pro. Ngôn ngữ văn bản được hỗ trợ: %@."
          }
        },
        "zh-Hans" : {
