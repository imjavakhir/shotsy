    },
    "Suggestions only. Motion blur or soft focus can be on purpose. Screenshots, videos and favorites are left out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Vorschläge. Bewegungsunschärfe oder weicher Fokus können gewollt sein. Bildschirmfotos, Videos und Favoriten sind ausgenommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo son sugerencias. El desenfoque por movimiento o el enfoque suave pueden ser intencionales. Se excluyen capturas, videos y favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simples suggestions. Un flou de bougé ou une mise au point douce peuvent être voulus. Les captures, vidéos et favoris sont exclus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya saran. Buram karena gerakan atau fokus lembut bisa jadi disengaja. Jepretan layar, video, dan favorit tidak disertakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono solo suggerimenti. Il mosso o il fuoco morbido possono essere voluti. Istantanee schermo, video e preferiti sono esclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あくまで候補です。被写体ブレやソフトフォーカスは意図的な場合もあります。スクリーンショット、ビデオ、お気に入りは対象外です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제안일 뿐이에요. 모션 블러나 부드러운 초점은 의도한 것일 수 있어요. 스크린샷, 비디오, 즐겨찾기는 제외됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São só sugestões. Desfoque de movimento ou foco suave podem ser intencionais. Capturas de tela, vídeos e favoritos ficam de fora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это лишь предложения. Смаз или мягкий фокус могут быть задуманы. Снимки экрана, видео и Избранное не учитываются."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ là gợi ý. Nhòe chuyển động hay lấy nét mềm có thể là cố ý. Ảnh màn hình, video và mục ưa thích không được tính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅供参考。动态模糊或柔焦可能是有意为之。截屏、视频和个人收藏不包括在内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅供參考。動態模糊或柔焦可能是刻意的。截圖、影片和喜好項目不會列入。"
          }
        }
      }
    },
    "Swipe as much as you like, every day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische, so viel du willst – jeden Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza todo lo que quieras, cada día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez autant que vous voulez, chaque jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser sepuasnya, setiap hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri quanto vuoi, ogni giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日、好きなだけスワイプ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 원하는 만큼 스와이프하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize o quanto quiser, todos os dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахивайте сколько угодно, каждый день."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt thoải mái mỗi ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天想滑多少就滑多少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天想滑多少就滑多少。"
          }
        }
      }
    },
    "Swipe right to keep, left to mark for deletion, up to add to an album, or use the actions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach rechts wischen zum Behalten, nach links zum Markieren für das Löschen, nach oben zum Hinzufügen zu einem Album, oder die Aktionen verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la derecha para conservar, a la izquierda para marcar para eliminar, hacia arriba para añadir a un álbum, o usa las acciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez à droite pour garder, à gauche pour marquer à supprimer, vers le haut pour ajouter à un album, ou utilisez les actions."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser ke kanan untuk menyimpan, ke kiri untuk menandai hapus, ke atas untuk menambahkan ke album, atau gunakan tindakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri a destra per tenere, a sinistra per segnare da eliminare, verso l'alto per aggiungere a un album, oppure usa le azioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右にスワイプで残す、左で削除候補にする、上でアルバムに追加。またはアクションを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽으로 스와이프하면 보관, 왼쪽은 삭제 표시, 위쪽은 앨범에 추가합니다. 또는 동작을 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a direita para manter, para a esquerda para marcar para apagar, para cima para adicionar a um álbum, ou use as ações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните вправо, чтобы оставить, влево — чтобы отметить на удаление, вверх — чтобы добавить в альбом, или используйте действия."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt phải để giữ, vuốt trái để đánh dấu xóa, vuốt lên để thêm vào album, hoặc dùng các thao tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向右滑动保留，向左滑动标记删除，向上滑动添加到相簿，或使用操作按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向右滑動保留，向左滑動標記刪除，向上滑動加入相簿，或使用操作按鈕。"
          }
        }
      }
    },
