    "Turn on access in Settings to sort your library. Settings, restore purchases, and legal links still work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere den Zugriff in den Einstellungen, um deine Mediathek zu sortieren. Einstellungen, Käufe wiederherstellen und rechtliche Links funktionieren weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el acceso en Configuración para ordenar tu fototeca. La configuración, restaurar compras y los enlaces legales siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez l’accès dans Réglages pour trier votre photothèque. Les réglages, la restauration des achats et les liens légaux restent disponibles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan akses di Pengaturan untuk memilah perpustakaan Anda. Pengaturan, pemulihan pembelian, dan tautan hukum tetap berfungsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva l'accesso in Impostazioni per ordinare la libreria. Impostazioni, ripristino acquisti e link legali funzionano comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリを整理するには、設定でアクセスをオンにしてください。設定、購入の復元、規約へのリンクは引き続き使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함을 정리하려면 설정에서 접근을 켜세요. 설정, 구입 항목 복원, 법적 고지 링크는 계속 사용할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o acesso nos Ajustes para organizar sua biblioteca. Ajustes, restaurar compras e links legais continuam funcionando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите доступ в Настройках, чтобы разбирать медиатеку. Настройки, восстановление покупок и юридические ссылки по-прежнему работают."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy bật quyền truy cập trong Cài đặt để phân loại thư viện. Cài đặt, khôi phục giao dịch mua và các liên kết pháp lý vẫn hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中开启访问权限即可整理图库。设置、恢复购买和法律链接仍可正常使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中開啟取用權限來整理圖庫。設定、回復購買項目和法律條款連結仍可使用。"
          }
        }
      }
    },
